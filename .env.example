# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
# TLS hacia la base de datos. Obligatorio si la base no vive en el mismo host
# que la aplicación (viajan datos personales por la red).
DB_SSL=false
# Solo para proveedores con certificado autofirmado. Deja el canal cifrado
# pero sin validar la contraparte.
DB_SSL_REJECT_UNAUTHORIZED=true

# Auth
# Generar con: openssl rand -base64 48
JWT_SECRET=generate_a_long_random_secret_here

# CORS. Admite varios orígenes separados por coma (p. ej. con y sin www).
# En producción deben ser https:// — la aplicación aborta el arranque si no.
FRONTEND_URL=http://localhost:5173

# Server
PORT=3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Drive OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_folder_id

# Mail (Gmail SMTP)
GMAIL_USER=your_gmail_account@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAIL_FROM="Piscinas El Maipo <your_gmail_account@gmail.com>"
